{
  "name": "ai-carry-dashboard",
  "private": true,
  "version": "2.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "actions:generate": "node scripts/generate-dashboard-actions.mjs",
    "instantiate": "node scripts/first-instantiation-transaction.mjs",
    "upgrade": "node scripts/ai-carry-upgrade-cli.mjs",
    "runtime-boundary": "node scripts/copied-instance-runtime-boundary.mjs",
    "check:actions": "node scripts/generate-dashboard-actions.mjs --check && node scripts/validate-action-mirror.mjs",
    "check:first-run": "node scripts/validate-first-run-contract.mjs",
    "check:change-quality": "node scripts/validate-change-quality-contract.mjs",
    "check:startup-budget": "node scripts/validate-startup-budget.mjs",
    "check:startup-capsule": "node scripts/validate-startup-capsule-contract.mjs && node scripts/validate-startup-capsule-sync.mjs",
    "check:secret-boundary": "node scripts/validate-secret-content-boundary.mjs",
    "check:snapshot-source": "node scripts/validate-snapshot-source-builder.mjs",
    "check:dashboard-data": "node scripts/validate-dashboard-data.mjs",
    "check:skill-workshop": "node scripts/validate-skill-workshop-contract.mjs",
    "check:skill-install": "node scripts/validate-skill-install-transaction.mjs",
    "check:problem-report": "node scripts/validate-problem-report-contract.mjs",
    "check:learning-recall": "node scripts/validate-learning-recall-contract.mjs",
    "check:learning-fixture": "node scripts/validate-learning-recall-fixture.mjs",
    "check:learning-promotion": "node scripts/validate-learning-promotion-contract.mjs && node scripts/validate-learning-promotion-transaction.mjs",
    "check:learning-capture": "node scripts/validate-learning-capture-journey.mjs",
    "check:learning-capture:maintenance": "node scripts/validate-learning-capture-transaction.mjs",
    "check:proactive-learning": "node scripts/validate-proactive-learning-guidance.mjs",
    "check:task-closeout": "node scripts/validate-task-closeout-contract.mjs",
    "check:upgrade-session": "node scripts/validate-upgrade-session-activation.mjs",
    "check:upgrade-cli": "node scripts/validate-ai-carry-upgrade-cli.mjs && node scripts/validate-upgrade-local-containment.mjs",
    "check:release-authority": "node scripts/validate-release-authority.mjs",
    "check:product-identity": "node scripts/validate-product-identity-contract.mjs",
    "check:brand-residuals": "node scripts/validate-brand-residuals.mjs",
    "check:instance-components": "node scripts/validate-instance-component-contract.mjs",
    "learning-save": "node scripts/learning-save-cli.mjs",
    "skill-install": "node scripts/skill-install-cli.mjs",
    "learning-capture": "node scripts/learning-capture-cli.mjs",
    "learning-promotion": "node scripts/learning-promotion-cli.mjs",
    "cross-session-signal": "node scripts/cross-session-signal-cli.mjs",
    "check:signal-transaction": "node scripts/validate-cross-session-signal-transaction.mjs",
    "check:fault-tolerance": "node scripts/validate-operational-user-report.mjs",
    "check:asset-query": "node scripts/validate-query-assets-contract.mjs",
    "check:localization": "node scripts/validate-localization-contract.mjs",
    "check:territory": "node scripts/validate-territory-terminology.mjs",
    "check:territory:dist": "node scripts/validate-territory-terminology.mjs --include-dist",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "check:licenses": "node scripts/generate-third-party-notices.mjs --check",
    "check:compliance": "node scripts/validate-open-source-compliance.mjs --self-test --allow-local-dependencies",
    "compliance:manifest": "node scripts/validate-open-source-compliance.mjs --write-distribution-manifest",
    "check:offline": "node scripts/validate-offline-assets.mjs",
    "check:snapshots": "node scripts/validate-formal-template-snapshots.mjs --self-test",
    "check:snapshot-sync": "node scripts/validate-snapshot-sync-transaction.mjs",
    "check:journeys": "npm run check:first-run && npm run check:learning-capture && npm run check:skill-install",
    "check:lifelines": "npm run check:journeys",
    "check:release": "npm run check:journeys && npm run check:dashboard-data && npm run check:proactive-learning && npm run check:skill-workshop && npm run check:upgrade-cli && npm run check:task-closeout && npm run check:problem-report && npm run check:product-identity && npm run check:startup-budget && npm run check:release-authority && npm run check:secret-boundary && npm run check:licenses && npm run check:compliance",
    "build": "npm run check:actions && tsc -b && vite build && node scripts/make-offline.mjs && npm run check:territory:dist && npm run check:offline",
    "analyze": "vite build --mode analyze",
    "preview": "vite preview"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "@gsap/react": "2.1.2",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "motion": "^12.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
